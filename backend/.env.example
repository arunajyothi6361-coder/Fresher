# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/virtual-classroom
DB_HOST=localhost
DB_PORT=27017
DB_NAME=virtual-classroom

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# CORS
FRONTEND_URL=http://localhost:3000

# AEB Technology Integration
AEB_API_KEY=your_aeb_api_key_here
AEB_API_ENDPOINT=https://api.aeb-tech.com
AEB_ENABLE_ANALYTICS=true
AEB_ENABLE_PERSONALIZATION=true

# Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=classroom-recordings

# Session Recording
RECORDING_ENABLED=true
RECORDING_FORMAT=mp4
MAX_RECORDING_DURATION=14400
